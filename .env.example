# omocop-m365 configuration
#
# Copy to .env for the AUTH SERVER. Note that the MCP server itself does not read
# this file — see the note at the bottom, it is the most common setup mistake.

# --- Required ---------------------------------------------------------------

# Application (client) ID from your Azure app registration.
M365_CLIENT_ID=your-client-id-here

# Client secret VALUE from Azure — not the Secret ID. Using the ID produces
# AADSTS7000215, which reads like a wrong password and wastes an afternoon.
M365_CLIENT_SECRET=your-client-secret-value-here

# --- Optional ---------------------------------------------------------------

# Directory (tenant) ID. Leave blank for personal Microsoft accounts, which use
# the shared 'common' endpoint.
M365_TENANT_ID=

# Windows timezone name applied to naive timestamps, e.g. "W. Europe Standard
# Time", "Eastern Standard Time". Defaults to UTC. This is a Windows name, not
# an IANA one — "Europe/Budapest" will not work.
M365_TIMEZONE=UTC

# Where OAuth tokens are cached. Defaults to ~/.omocop-m365-tokens.json.
# M365_TOKEN_STORE=

# Port for the local OAuth callback server.
M365_AUTH_PORT=3333

# error | warn | info | debug — all logging goes to stderr, never stdout.
LOG_LEVEL=info

# Space-separated Graph scopes. Defaults to what the shipped tools need; see
# docs/rationale.md for how that set was chosen.
# M365_SCOPES=

# --- Why this file is not enough --------------------------------------------
#
# An MCP server is launched by its client (Claude Code, Claude Desktop), not by
# a shell, so it does not inherit your environment and does not read .env. This
# file configures `npm run auth` only.
#
# The server gets its credentials from the `env` block of your MCP client
# configuration. See docs/setup.md.
